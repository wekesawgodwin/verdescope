# Copy to backend/.env for local development (never commit the real file)
ENVIRONMENT=development
DATABASE_URL=postgresql://verdescope:verdescope@localhost:5433/verdescope
SECRET_KEY=change-me-to-a-long-random-string
SEED_DEMO=true

# First admin for a real (non-demo) deployment
# ADMIN_EMAIL=you@yourdomain.co.ke
# ADMIN_PASSWORD=a-strong-password

# Outbound email (company mailbox replies)
# EMAIL_PROVIDER=resend          # or smtp
# MAIL_FROM=info@yourdomain.co.ke
# RESEND_API_KEY=re_xxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=info@yourdomain.co.ke
# SMTP_PASSWORD=app-password
